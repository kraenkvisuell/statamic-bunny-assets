{
    "name": "kraenkvisuell/statamic-bunny-assets",
    "description": "Statamic 6 on Bunny Storage + CDN: parallel uploads that don't drop each other's files, CP thumbnails from the Glide CDN, original GIFs, retried reads and a meta cache warmer.",
    "homepage": "https://github.com/kraenkvisuell/statamic-bunny-assets",
    "keywords": [
        "statamic",
        "statamic-addon",
        "bunny",
        "bunny.net",
        "s3",
        "glide"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "kraenkvisuell",
            "homepage": "https://github.com/kraenkvisuell"
        }
    ],
    "type": "statamic-addon",
    "require": {
        "php": "^8.3",
        "league/flysystem-aws-s3-v3": "^3.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "league/flysystem-memory": "^3.0",
        "orchestra/testbench": "^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kraenkvisuell\\StatamicBunnyAssets\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kraenkvisuell\\StatamicBunnyAssets\\Tests\\": "tests"
        }
    },
    "extra": {
        "statamic": {
            "name": "Statamic Bunny Assets",
            "description": "Statamic on Bunny Storage + CDN"
        },
        "laravel": {
            "providers": [
                "Kraenkvisuell\\StatamicBunnyAssets\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
